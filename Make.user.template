
# =========================
# specials / kind

#WOMO = 1

# =========================
# services to build/use

#MOPEKA = 1
#GARMIN = 1
#GPS = 1
#VDR = 1
#THETFORD = 1
#HOMEMATIC = 1

# =========================
# personalization

INIT_AFTER = mysql.service

# directory for sources built by 'make install-dependencies' (libgpiod, libwebsockets)

SRC_DIR = /usr/src
ETH_IFACE = eth0
SUBNET = 192.168.100
STATIC_IP = 192.168.100.10
MQTT_HOST = 192.168.100.10
DOMAIN = womo.lan

# used at least for Arduinos and ESPs

#WIFI_SSID = xxxx
#WIFI_PWD = yyyy

# =========================
# ESP32 sketches

# *_PORT: serial port (USB) of the ESP32 for 'make upload' / 'make monitor'
# *_OTA_HOST / *_OTA_PWD: OTA (over the air) = flash the firmware via WLAN instead of USB
#   ('make upload-ota'), IP of the ESP32 (fixed IP in the router) and optional password
#   (empty = none); the first upload has to be done via USB ('make upload')

# -------------------------
# parameter for alpicool ESP32 (see kenwood above for PORT / OTA)

# ALPI_MAC is the mac of the bluetooth interface frim the cooling box!

#ALPI_MAC = FC:E4:97:72:E9:83
#ALPICOOL_PORT = /dev/ttyACM0
#ALPICOOL_OTA_HOST = 192.168.220.34
#ALPICOOL_OTA_PWD =

# -------------------------
# Parameter for tpms / ESP32 (tire pressure valve caps)

# the caps are mapped to the wheels in the WEBIF config 'TPMS:<deviceid>' (see tpms/README.md)

#TPMS_PORT = /dev/ttyACM0
#TPMS_OTA_HOST = 192.168.220.35
#TPMS_OTA_PWD =

# -------------------------
# Parameter for kenwood / ESP32

#KENWOOD_PORT = /dev/ttyACM0
#KENWOOD_OTA_HOST = 192.168.220.33
#KENWOOD_OTA_PWD =

# WLAN MAC of the remote (Super Mini)
#  empty/unset = receiver off
#  ALL accept all connections
#KENWOOD_REMOTE_MAC = ALL

# -------------------------
# Parameter for kenwood-remote / XIAO ESP32C3 (steering wheel remote, ESP-NOW)

# the WIFI_CHANNEL of the access point must be set to a fixed value!
#WIFI_CHANNEL = 6

#KENWOOD_REMOTE_PORT = /dev/ttyACM0

# KENWOOD_MAC: WLAN MAC of the kenwood ESP, WIFI_CHANNEL: fixed channel of the router
#KENWOOD_MAC = b0:cb:d8:98:6b:40
