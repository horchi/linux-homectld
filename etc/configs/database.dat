
// ----------------------------------------------------------------
// Table valueTypes
// ----------------------------------------------------------------

Table valuetypes
{
   TYPE                 ""          type                 Ascii        8 Primary,

   INSSP                ""          inssp                Int         10 Meta,
   UPDSP                ""          updsp                Int         10 Meta,

   TITLE                ""          title                Ascii       30 Data,
}

// ----------------------------------------------------------------
// Table ValueFacts
// ----------------------------------------------------------------

Table valuefacts
{
   ADDRESS      ""                               address              UInt         4 Primary,
   TYPE         ""                               type                 Ascii        8 Primary,

   INSSP        ""                               inssp                Int         10 Meta,
   UPDSP        ""                               updsp                Int         10 Meta,

   GROUPID      ""                               groupid              Int         10 Data,
   STATE        ""                               state                Ascii        1 Data,
   RECORD       ""                               record               Ascii        1 Data,
   UNIT         ""                               unit                 Ascii        5 Data,
   OPTIONS      ""                               options              Int         10 Data,
   FACTOR       ""                               factor               Int          4 Data,
   NAME         ""                               name                 Ascii      100 Data,
   TITLE        ""                               title                Ascii      100 Data,
   USRTITLE     ""                               usrtitle             Ascii      100 Data,
   SUBTYPE      "data type"                      res1                 Int          4 Data,
   CHOICES      ""                               choices              Ascii      250 Data,
   RIGHTS       "control rights"                 rights               Int          0 Data,
   PARAMETER    "widget settings (look)"         parameter            Text      1000 Data,
   SETTINGS     "JSON (sensor settings / lua)"   calibration          Text      5000 Data,
}

// ----------------------------------------------------------------
// Table Samples
// ----------------------------------------------------------------

Table samples
{
   ADDRESS              ""  address              UInt         4 Primary,
   TYPE                 ""  type                 Ascii        8 Primary,
   AGGREGATE            ""  aggregate            Ascii        1 Primary,
   TIME                 ""  time                 DateTime     0 Primary,

   INSSP                ""  inssp                Int         10 Meta,
   UPDSP                ""  updsp                Int         10 Meta,

   VALUE                ""  value                Float      122 Data,
   TEXT                 ""  text                 Ascii      200 Data,
   SAMPLES              ""  samples              Int          3 Data,
}

// ----------------------------------------------------------------
// Indices for Samples
// ----------------------------------------------------------------

Index samples
{
   time                 ""  TIME,
   type                 ""  TYPE,
   aggregate            ""  AGGREGATE,
   addr_type_time       ""  ADDRESS TYPE TIME,
}

// ----------------------------------------------------------------
// Table peaks
// ----------------------------------------------------------------

Table peaks
{
   ADDRESS              ""  address              UInt         4 Primary,
   TYPE                 ""  type                 Ascii        8 Primary,

   INSSP                ""  inssp                Int         10 Meta,
   UPDSP                ""  updsp                Int         10 Meta,

   TIMEMIN              ""  timemin              DateTime     0 Data,
   TIMEMAX              ""  timemax              DateTime     0 Data,
   MIN                  ""  minv                 Float      122 Data,
   MAX                  ""  maxv                 Float      122 Data,
}

// ----------------------------------------------------------------
// Groups (Baugruppen)
// ----------------------------------------------------------------

Table groups
{
   ID                   ""  id                   UInt         4 Primary|Autoinc,
   NAME                 ""  name                 Ascii      100 Data,
}

// ----------------------------------------------------------------
// Table Config
// ----------------------------------------------------------------

Table config
{
   OWNER                ""                 owner           Ascii     40 Primary,
   NAME                 ""                 name            Ascii     40 Primary,

   TYPE                 ""                 type            Int        0 Data,
   TITLE                ""                 title           Ascii    100 Data,
   CATEGORY             ""                 category        Ascii     40 Data,
   DESCRIPTION          ""                 description     Ascii    500 Data,
   INTERNAL             ""                 internal        Ascii      1 Data,
   KIND                 "U - user defined" kind            Ascii      1 Data,
   ORD                  "display order"    ord             Int        0 Data,
   INSSP                ""                 inssp           Int        0 Meta,
   UPDSP                ""                 updsp           Int        0 Meta,
   VALUE                ""                 value           Text    1500 Data,
}

// ----------------------------------------------------------------
// Table Dashboards
// ----------------------------------------------------------------

Table dashboards
{
   ID                   ""  id                   UInt         4 Primary|Autoinc,

   INSSP                ""  inssp                Int          0 Meta,
   UPDSP                ""  updsp                Int          0 Meta,

   TITLE                ""  title                Ascii      100 Data,
   GROUP                ""  grp                  Int         10 Data,
   SYMBOL               ""  symbol               Ascii      100 Data,
   ORDER                ""  ord                  Int         10 Data,
   OPTS                 ""  opts                 Ascii      200 Data,
}

// ----------------------------------------------------------------
// Table DashboardWidgets
// ----------------------------------------------------------------

Table dashboardwidgets
{
   DASHBOARDID          ""  dashboardid          UInt         4 Primary,
   ADDRESS              ""  address              UInt         4 Primary,
   TYPE                 ""  type                 Ascii        8 Primary,

   INSSP                ""  inssp                Int          0 Meta,
   UPDSP                ""  updsp                Int          0 Meta,

   WIDGETOPTS           ""  widgetopts           Ascii     1000 Data,
   ORDER                ""  ord                  Int         10 Data,
}

// ----------------------------------------------------------------
// Table HaspPages (openHASP panel pages)
// ----------------------------------------------------------------

Table hasppages
{
   ID                   ""  id                   UInt         4 Primary|Autoinc,

   INSSP                ""  inssp                Int          0 Meta,
   UPDSP                ""  updsp                Int          0 Meta,

   TITLE                ""  title                Ascii      100 Data,
   ORDER                ""  ord                  Int         10 Data,
   COLUMNS              ""  ncols                Int         10 Data,
   ROWS                 ""  nrows                Int         10 Data,
   OPTS                 ""  opts                 Ascii      500 Data,
}

// ----------------------------------------------------------------
// Table HaspPageWidgets (one row per occupied slot of a page)
// ----------------------------------------------------------------

Table hasppagewidgets
{
   PAGEID               ""  pageid               UInt         4 Primary,
   POSITION             ""  pos                  Int          4 Primary,

   INSSP                ""  inssp                Int          0 Meta,
   UPDSP                ""  updsp                Int          0 Meta,

   ADDRESS              ""  address              UInt         4 Data,
   TYPE                 ""  type                 Ascii        8 Data,
   WIDGETOPTS           ""  widgetopts           Ascii     1000 Data,
}

// ----------------------------------------------------------------
// Table HtmlWidgets (snippets of the dashboard widget 'HTML',
//   referenced by the widget options {"snippet": <id>, "params": {...}})
// ----------------------------------------------------------------

Table htmlwidgets
{
   ID                   ""                              id                   UInt         4 Primary|Autoinc,

   INSSP                ""                              inssp                Int          0 Meta,
   UPDSP                ""                              updsp                Int          0 Meta,

   NAME                 ""                              name                 Ascii      100 Data,
   KIND                 "'html' | 'iframe'"             kind                 Ascii       10 Data,
   CODE                 "template resp. URL"            code                 MText   200000 Data,
   CSS                  "scoped to the widget"          css                  Text     10000 Data,
   PARAMETERS           "JSON object, name -> default"  parameters           Text      2000 Data,
}

// ----------------------------------------------------------------
// Table GpsTours (recorded GPS tours, the points are in 'samples' GPS:0x0a)
// ----------------------------------------------------------------

Table gpstours
{
   ID                   ""                              id                   UInt         4 Primary|Autoinc,

   INSSP                ""                              inssp                Int          0 Meta,
   UPDSP                ""                              updsp                Int          0 Meta,

   NAME                 ""                              name                 Ascii      100 Data,
   START                ""                              starttime            DateTime     0 Data,
   STOP                 "NULL -> tour is active"        stoptime             DateTime     0 Data,
   DISTANCE             "[m]"                           distance             Float      122 Data,
   POINTS               ""                              points               Int         10 Data,
   PAUSETIME            "[s]"                           pausetime            Int         10 Data,
   ODOMETER             "[km] at start"                 odometer             Int         10 Data,
   ODOMETEREND          "[km] at the end"               odometerend          Int         10 Data,
   COMMENT              "free text for the whole tour"  comment              Text      2000 Data,
}

Table gpstourevents
{
   ID                   ""                                                              id                   UInt         4 Primary|Autoinc,

   INSSP                ""                                                              inssp                Int          0 Meta,
   UPDSP                ""                                                              updsp                Int          0 Meta,

   TOURID               ""                                                              tourid               UInt        10 Data,
   TIME                 ""                                                              time                 DateTime     0 Data,
   TYPE                 "fuel, toll, pause, night, note, ferry, halt (automatic)"       type                 Ascii       10 Data,
   ENDTIME              "halt: end of the standstill, ferry: end of the crossing"       endtime              DateTime     0 Data,
   LAT                  ""                                                              lat                  Float      126 Data,
   LON                  ""                                                              lon                  Float      126 Data,
   ENDLAT               "ferry: position at the end (unknown without GPS fix)"          endlat               Float      126 Data,
   ENDLON               ""                                                              endlon               Float      126 Data,
   ENDDISTANCE          "ferry: [m] GPS distance of the tour at the end"                enddistance          Float      122 Data,
   ODOMETER             "[km]"                                                          odometer             Int         10 Data,
   DISTANCE             "[m] GPS distance of the tour at this moment"                   distance             Float      122 Data,
   AMOUNT               "fuel [l]"                                                      amount               Float      102 Data,
   FULL                 "fuel: 1 = tank filled up, 0 = partial"                         full                 Int          1 Data,
   PRICE                "total costs [EUR]"                                             price                Float      102 Data,
   NOTE                 ""                                                              note                 Ascii      200 Data,
}

Table activities
{
   GARMINID             ""                                                                        garminid             UBigInt     20 Primary,

   INSSP                ""                                                                        inssp                Int          0 Meta,
   UPDSP                ""                                                                        updsp                Int          0 Meta,

   START                ""                                                                        starttime            DateTime     0 Data,
   TYPE                 "Garmin typeKey (e.g. windsurfing)"                                       type                 Ascii       50 Data,
   TYPEID               ""                                                                        typeid               Int         10 Data,
   PARENTTYPEID         ""                                                                        parenttypeid         Int         10 Data,
   NAME                 ""                                                                        name                 Ascii      200 Data,
   LOCATION             ""                                                                        location             Ascii      100 Data,
   DURATION             "[s]"                                                                     duration             Int         10 Data,
   MOVING               "[s]"                                                                     moving               Int         10 Data,
   ELAPSED              "[s]"                                                                     elapsed              Int         10 Data,
   DISTANCE             "[m]"                                                                     distance             Float      122 Data,
   ELEVGAIN             "[m]"                                                                     elevgain             Float      122 Data,
   ELEVLOSS             "[m]"                                                                     elevloss             Float      122 Data,
   AVGSPEED             "[m/s]"                                                                   avgspeed             Float      123 Data,
   MAXSPEED             "[m/s]"                                                                   maxspeed             Float      123 Data,
   AVGHR                ""                                                                        avghr                Int         10 Data,
   MAXHR                ""                                                                        maxhr                Int         10 Data,
   CALORIES             ""                                                                        calories             Int         10 Data,
   STEPS                ""                                                                        steps                Int         10 Data,
   LAT                  ""                                                                        lat                  Float      126 Data,
   LON                  ""                                                                        lon                  Float      126 Data,
   TRACKDISTANCE        "[m] sum of the stored track's segments (fallback for a wrong DISTANCE)"  trackdistance        Float      122 Data,
   DETAILS              "cached JSON of 'garmin.py details'"                                      details              Text     60000 Data,
}

Table activitytracks
{
   GARMINID             ""                                                                          garminid             UBigInt     20 Primary,

   INSSP                ""                                                                          inssp                Int          0 Meta,
   UPDSP                ""                                                                          updsp                Int          0 Meta,

   POINTS               "number of points"                                                          points               Int         10 Data,
   TRACK                "JSON [[lat, lon, time, alt, speed], ...] (size = buffer, not the column)"  track                MText  1000000 Data,
}

// ----------------------------------------------------------------
// Table Users
// ----------------------------------------------------------------

Table users
{
   USER                 ""               user      Ascii      40 Primary,
   INSSP                ""               inssp     Int         0 Meta,
   UPDSP                ""               updsp     Int         0 Meta,
   PASSWD               "md5 sum"        passwd    Ascii      40 Data,
   TOKEN                ""               token     Ascii     200 Data,
   RIGHTS               "Rights Bitmask" rights    INT       200 Data,
}

// ----------------------------------------------------------------
// Table SensorAlert
// ----------------------------------------------------------------

Table sensoralert
{
   ID                   ""                         id                   UInt        11 Primary|Autoinc,

   INSSP                ""                         inssp                Int         10 Meta,
   UPDSP                ""                         updsp                Int         10 Meta,

   KIND                 "'S'ub or 'M'aster rule"   kind                 Ascii        1 Data,
   SUBID                "reference to 'sub' rule"  subid                UInt        11 Data,
   LGOP                 "logical operator"         lgop                 UInt         0 Data,

   ADDRESS              ""                         address              UInt         4 Data,
   TYPE                 ""                         type                 Ascii        8 Data,
   STATE                ""                         state                Ascii        1 Data,
   MIN                  ""                         min                  Int         10 Data,
   MAX                  ""                         max                  Int         10 Data,
   RANGEM               ""                         rangem               Int         10 Data,
   DELTA                ""                         delta                Int         10 Data,
   MADDRESS             ""                         maddress             Ascii      100 Data,
   MSUBJECT             ""                         msubject             Ascii      100 Data,
   MBODY                ""                         mbody                Text      2000 Data,
   LASTALERT            ""                         lastalert            Int         10 Data,
   MAXREPEAT            "[minutes]"                maxrepeat            Int         10 Data,
}

// ----------------------------------------------------------------
// Table SchemaConf
// ----------------------------------------------------------------

Table schemaconf
{
   ADDRESS              ""  address              UInt         4 Primary,
   TYPE                 ""  type                 Ascii        8 Primary,

   INSSP                ""  inssp                Int         10 Meta,
   UPDSP                ""  updsp                Int         10 Meta,

   STATE                ""  state                Ascii        1 Data,
   KIND                 "kind of display" kind   Int          1 Data,
   WIDTH                "image width"     width  Int          1 Data,
   HEIGHT               "image height"    height Int          1 Data,
   SHOWUNIT             ""  showunit             Int          1 Data,
   SHOWTITLE            ""  showtitle            Int          1 Data,
   USRTEXT              ""  usrtext              Ascii      100 Data,
   FUNCTION             ""  function             Text      2000 Data,
   PROPERTIES           ""  properties           Text      1000 Data,
}

// ----------------------------------------------------------------
// Table states
// ----------------------------------------------------------------

Table iostates
{
   TYPE       ""            type                 Ascii        8 Primary,
   ADDRESS    ""            address              UInt         4 Primary,

   TIME       "Changed At"  time                 DateTime     0 Data,
   LAST       "Last Data"   last                 DateTime     0 Data,
   KIND       ""            kind                 Ascii       10 Data,

   VALUE      ""            value                Float      122 Data,
   TEXT       ""            text                 Ascii      200 Data,
   STATE      ""            state                Int         10 Data,
   MODE       ""            mode                 Int         10 Data,
}

// ----------------------------------------------------------------
