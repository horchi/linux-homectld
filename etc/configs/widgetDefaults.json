{
  "type": "homectld-widgetdefaults",
  "version": 1,

  "_comment": [
    "Fallback widget properties, used when a sensor brings none of its own (see widgetDefaults2Json()).",
    "properties: the first entry matching type (exact), unit ('*' = any) and address (optional, missing = any)",
    "            wins, none matching -> 'default'; widgettype by name (Symbol, Chart, Text, Value, Gauge, Meter,",
    "            MeterLevel, PlainText, Choice, SymbolValue, Spacer, Time, SymbolText, BarChart, SpecialSymbol,",
    "            Level, Balance, Timer, HTML), missing -> by the unit, see unitWidgetTypes",
    "            scalemin / scalemax / scalestep missing -> 0, showpeak missing -> false,",
    "            color / colorOn missing -> those of 'default'",
    "unitWidgetTypes: the widget type by the unit for entries without 'widgettype', '*' for all other units",
    "symbols:    the first rule matching wins; all criteria given must match (AND), a list matches any of its",
    "            entries (OR), 'title' is a case insensitive part of the title, a rule without criteria matches",
    "            always; 'on' / 'off' an image path (img/...) or a MDI symbol (mdi:mdi-...), 'symbol' sets both",
    "valueTypes: title and symbol of the sensor groups (WEBIF list, IO setup, alerts), the first entry whose",
    "            'type' (regular expression) matches the sensor type wins, none -> title = type, no symbol",
    "delivered with homectld, replaced on each install - own rules go to widgetDefaults-usr.json (checked first)"
  ],

  "valueTypes": [
    { "type": "^VA$",         "title": "Messwerte",             "symbol": "mdi:mdi-chart-line" },
    { "type": "^SD",          "title": "Status Laufzeiten",     "symbol": "mdi:mdi-timer-outline" },
    { "type": "^DO",          "title": "Digitale Ausgänge",     "symbol": "mdi:mdi-toggle-switch-outline" },
    { "type": "^MCPO",        "title": "Digitale Ausgänge",     "symbol": "mdi:mdi-toggle-switch-outline" },
    { "type": "^DI",          "title": "Digitale Eingänge",     "symbol": "mdi:mdi-electric-switch" },
    { "type": "^MCPI",        "title": "Digitale Eingänge",     "symbol": "mdi:mdi-electric-switch" },
    { "type": "^GPIO",        "title": "GPIO",                  "symbol": "mdi:mdi-chip" },
    { "type": "^W1",          "title": "One Wire Sensoren",     "symbol": "mdi:mdi-thermometer" },
    { "type": "^DS[0-9a-f]",  "title": "One Wire Sensoren",     "symbol": "mdi:mdi-thermometer" },
    { "type": "^SCN$",        "title": "Szenen",                "symbol": "mdi:mdi-play-box-multiple-outline" },
    { "type": "^SC",          "title": "Skripte",               "symbol": "mdi:mdi-script-text-outline" },
    { "type": "^AO",          "title": "Analog Ausgänge",       "symbol": "mdi:mdi-sine-wave" },
    { "type": "^AI",          "title": "Analog Eingänge",       "symbol": "mdi:mdi-sine-wave" },
    { "type": "^ADS",         "title": "Analog Eingänge",       "symbol": "mdi:mdi-sine-wave" },
    { "type": "^Sp",          "title": "Weitere Sensoren",      "symbol": "mdi:mdi-access-point" },
    { "type": "^DZLG",        "title": "DECONZ Lampen Gruppe",  "symbol": "mdi:mdi-lightbulb-group-outline" },
    { "type": "^DZL",         "title": "DECONZ Lampen",         "symbol": "mdi:mdi-lightbulb-outline" },
    { "type": "^DZS",         "title": "DECONZ Sensoren",       "symbol": "mdi:mdi-zigbee" },
    { "type": "^HM.*",        "title": "Home Matic",            "symbol": "mdi:mdi-home-automation" },
    { "type": "^P4.*",        "title": "P4 Daemon",             "symbol": "mdi:mdi-fire" },
    { "type": "^WEA",         "title": "Wetter",                "symbol": "mdi:mdi-weather-partly-cloudy" },
    { "type": "^SUN",         "title": "Sonne",                 "symbol": "mdi:mdi-white-balance-sunny" },
    { "type": "^DHT",         "title": "Wetter",                "symbol": "mdi:mdi-weather-partly-cloudy" },
    { "type": "^CV",          "title": "Calculated Values",     "symbol": "mdi:mdi-calculator-variant-outline" },
    { "type": "^PA",          "title": "Parameter",             "symbol": "mdi:mdi-tune-variant" },
    { "type": "^UD",          "title": "User Defined",          "symbol": "mdi:mdi-account-cog-outline" },
    { "type": "^VIC",         "title": "Victron",               "symbol": "mdi:mdi-battery-charging" },
    { "type": "^VOTRO",       "title": "Votronic",              "symbol": "mdi:mdi-battery-charging" },
    { "type": "^MOPEKA.*",    "title": "Mopeka",                "symbol": "mdi:mdi-gas-cylinder" },
    { "type": "^TPMS",        "title": "Reifendruck",           "symbol": "mdi:mdi-car-tire-alert" },
    { "type": "^GROWATT",     "title": "GROWATT",               "symbol": "mdi:mdi-solar-power-variant-outline" },
    { "type": "^TASMOTA",     "title": "TASMOTA",               "symbol": "mdi:mdi-power-socket-de" },
    { "type": "^BBQ",         "title": "BBQ",                   "symbol": "mdi:mdi-grill-outline" },
    { "type": "^SAMTV",       "title": "Samsung TV",            "symbol": "mdi:mdi-television" },
    { "type": "^DENON",       "title": "Denon AV Receiver",     "symbol": "mdi:mdi-audio-video" }
  ],

  "default": {
    "widgettype": "Meter",
    "scalemin": 0,
    "scalemax": 45,
    "scalestep": 10,
    "showpeak": false,
    "color": "rgb(255, 255, 255)",
    "colorOn": "rgb(235, 197, 5)"
  },

  "unitWidgetTypes": {
    "°C":   "MeterLevel",
    "V":    "Meter",
    "A":    "Meter",
    "txt":  "Text",
    "":     "Text",
    "stxt": "SymbolText",
    "sym":  "Symbol",
    "*":    "Meter"
  },

  "properties": [
    { "type": "SPACER", "unit": "*",    "widgettype": "Spacer" },
    { "type": "TIME",   "unit": "txt",  "widgettype": "PlainText",   "showpeak": true },
    { "type": "HTML",   "unit": "*",    "widgettype": "HTML" },
    { "type": "DO",     "unit": "*",    "widgettype": "Symbol" },
    { "type": "DI",     "unit": "*",    "widgettype": "Symbol" },
    { "type": "GPIO",   "unit": "*",    "widgettype": "Symbol" },
    { "type": "AO",     "unit": "*",    "widgettype": "Meter",       "scalemax": 45,   "scalestep": 10 },
    { "type": "AI",     "unit": "*",    "widgettype": "Meter",       "scalemax": 45,   "scalestep": 10 },
    { "type": "SD",     "unit": "*",    "widgettype": "Chart",       "scalemax": 2000, "showpeak": true },
    { "type": "SC",     "unit": "",     "widgettype": "Text" },
    { "type": "SC",     "unit": "txt",  "widgettype": "Text" },
    { "type": "SC",     "unit": "stxt", "widgettype": "SymbolText" },
    { "type": "SC",     "unit": "zst",  "widgettype": "Symbol" },
    { "type": "SC",     "unit": "*",    "widgettype": "Meter",       "scalemax": 40,   "scalestep": 10, "showpeak": true },
    { "type": "UD",     "unit": "txt",  "widgettype": "Text" },
    { "type": "UD",     "unit": "zst",  "widgettype": "SymbolText" },
    { "type": "UD",     "unit": "*",    "widgettype": "Text" },
    { "type": "W1",     "unit": "*",    "widgettype": "MeterLevel",  "scalemax": 40,   "scalestep": 10, "showpeak": true },
    { "type": "VA",     "unit": "%",    "widgettype": "MeterLevel",  "scalemax": 100,  "scalestep": 20, "showpeak": true },
    { "type": "VA",     "unit": "*",    "widgettype": "Meter",       "scalemax": 45,   "scalestep": 10, "showpeak": true },
    { "type": "HMB",    "unit": "*",    "widgettype": "SymbolValue", "showpeak": true, "color": "rgb(0 99 161)", "colorOn": "rgb(139, 184, 213)" },
    { "type": "DZL",    "unit": "*",    "widgettype": "Symbol",      "showpeak": true },
    { "type": "DZLG",   "unit": "*",    "widgettype": "Symbol",      "showpeak": true },
    { "type": "DZS",    "unit": "zst",  "widgettype": "Symbol",      "showpeak": true },
    { "type": "DZS",    "unit": "°C",   "widgettype": "MeterLevel",  "scalemax": 45,   "scalestep": 10, "showpeak": true },
    { "type": "DZS",    "unit": "%",    "widgettype": "Chart",       "showpeak": true },
    { "type": "DZS",    "unit": "hPa",  "widgettype": "Chart",       "showpeak": true },
    { "type": "DZS",    "unit": "mov",  "widgettype": "Symbol",      "showpeak": true },
    { "type": "DZS",    "unit": "lx",   "widgettype": "Chart",       "showpeak": true },
    { "type": "DZS",    "unit": "*",    "widgettype": "Meter",       "scalemax": 45,   "scalestep": 12, "showpeak": true },
    { "type": "WEA",    "unit": "°C",   "widgettype": "Value",       "showpeak": true },
    { "type": "WEA",    "unit": "txt",  "widgettype": "Text" },
    { "type": "WEA",    "unit": "",     "widgettype": "PlainText" },
    { "type": "WEA",    "unit": "*",    "widgettype": "Value",       "showpeak": true },
    { "type": "SUN",    "unit": "*",    "widgettype": "PlainText" },
    { "type": "N4000",  "unit": "*",    "widgettype": "Value" },
    { "type": "T2090",  "unit": "*",    "widgettype": "Value",       "showpeak": true },
    { "type": "CV",     "unit": "txt",  "widgettype": "Text",        "showpeak": true },
    { "type": "CV",     "unit": "°C",   "widgettype": "MeterLevel",  "showpeak": true },
    { "type": "CV",     "unit": "*",    "widgettype": "Symbol",      "showpeak": true },
    { "type": "SCN",    "unit": "*",    "widgettype": "Symbol",      "showpeak": true },
    { "type": "TPMS",   "unit": "*",    "widgettype": "Value" }
  ],

  "symbols": [
