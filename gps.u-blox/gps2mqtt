# Usage:
#  gpsmqtt [-h] [-i [I]] [-m [M]] [-p [P]] [-v [V]] [-l] [-T [T]] [-t [T]] [-s]
#
# optional arguments:
#   -h, --help  show this help message and exit
#   -i [I]      interval [seconds] (default 30)
#   -m [M]      MQTT host
#   -p [P]      MQTT port
#   -v [V]      Verbosity Level (0-3) (default 0)
#   -l          Log to Syslog (default console)
#   -T [T]      MQTT topic
#   -t [T]      Sensor type string
#   -s          Show current status and exit

GPS_MQTT="-m localhost"
GPS_TOPIC="-T homectld2mqtt/gps"
GPS_OPTS="-l"
GPS_LOG_LEVEL="-v 1"
GPS_INTERVAL="-i 30"
