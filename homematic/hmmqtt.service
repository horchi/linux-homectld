[Unit]

Description = HomeMatic (BidCos-RF via CUL) to MQTT service
After = network.target mosquitto.service
StartLimitInterval = 200
StartLimitBurst = 5

[Service]
EnvironmentFile=-/etc/default/hmmqtt
Type = forking
ExecStart = <BINDEST>/hmmqtt $HMMQTT_OPTS
Restart = always
RestartSec = 30

[Install]

WantedBy = multi-user.target
