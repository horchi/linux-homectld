+#if HASP_USE_MQTT > 0
+#include "mqtt/hasp_mqtt.h"
+
+/* Warnings and errors to the MQTT state topic 'log' (e.g. homectld shows them in its web interface,
+ * no USB connection needed). Log slot 2 (the slot of syslog, used only while no syslog host is set).
+ * One line is collected at a time: lines of other tasks meanwhile and the log of the publish itself
+ * are dropped, a repeated line is sent at most every 10 s. */
+
+class MqttLogOutput : public Print {
+  public:
+    size_t write(uint8_t c) override
+    {
+        if(active && owner == xTaskGetCurrentTaskHandle() && len < sizeof(text) - 1) text[len++] = (char)c;
+        return 1;
+    }
+
+    char text[192];
+    char last[192] = "";
+    char payload[512];
+    size_t len          = 0;
+    bool active         = false; // a line is collected
+    bool busy           = false; // the line is published
+    int level           = 0;
+    char tag[10]        = "";
+    TaskHandle_t owner  = NULL;
+    uint32_t lastSentMs = 0;
+};
+
+static MqttLogOutput mqttLogOutput;
+static portMUX_TYPE mqttLogMux = portMUX_INITIALIZER_UNLOCKED;
+
+bool debugMqttLogPrefix(uint8_t tag, int level, Print* _logOutput, const char* tagname)
+{
+    if(_logOutput != &mqttLogOutput) return false;
+
+    portENTER_CRITICAL(&mqttLogMux);
+    bool isFree = !mqttLogOutput.active && !mqttLogOutput.busy;
+    if(isFree) {
+        mqttLogOutput.active = true;
+        mqttLogOutput.owner  = xTaskGetCurrentTaskHandle();
+    }
+    portEXIT_CRITICAL(&mqttLogMux);
+
+    if(isFree) {
+        mqttLogOutput.len   = 0;
+        mqttLogOutput.level = level;
+        strncpy(mqttLogOutput.tag, tagname, sizeof(mqttLogOutput.tag) - 1);
+        mqttLogOutput.tag[sizeof(mqttLogOutput.tag) - 1] = 0;
+    }
+
+    return true;
+}
+
+bool debugMqttLogSuffix(Print* _logOutput)
+{
+    if(_logOutput != &mqttLogOutput) return false;
+    if(!mqttLogOutput.active || mqttLogOutput.owner != xTaskGetCurrentTaskHandle()) return true;
+
+    MqttLogOutput& o = mqttLogOutput;
+    o.busy           = true;
+    o.active         = false;
+    o.text[o.len]    = 0;
+
+    while(o.len && (o.text[o.len - 1] == ' ' || o.text[o.len - 1] == '\r' || o.text[o.len - 1] == '\n'))
+        o.text[--o.len] = 0;
+
+    bool repeated = strcmp(o.text, o.last) == 0 && millis() - o.lastSentMs < 10000;
+
+    if(o.len && !repeated && mqttIsConnected()) {
+        size_t n = snprintf_P(o.payload, sizeof(o.payload), PSTR("{\"level\":\"%s\",\"tag\":\"%s\",\"text\":\""),
+                              o.level <= LOG_LEVEL_ERROR ? "error" : "warning", o.tag);
+
+        for(const char* c = o.text; *c && n < sizeof(o.payload) - 8; c++) { // JSON string
+            if(*c == '"' || *c == '\\') {
+                o.payload[n++] = '\\';
+                o.payload[n++] = *c;
+            } else if((uint8_t)*c < 0x20) {
+                o.payload[n++] = ' ';
+            } else {
+                o.payload[n++] = *c;
+            }
+        }
+
+        strcpy(o.payload + n, "\"}");
+        mqtt_send_state("log", o.payload);
+        strcpy(o.last, o.text);
+        o.lastSentMs = millis();
+    }
+
+    o.owner = NULL;
+    o.busy  = false;
+    return true;
+}
+#endif // HASP_USE_MQTT
+
