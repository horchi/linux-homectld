+/* Backlight controlled by a board MCU / IO expander over I2C instead of a PWM pin
+ * (e.g. Elecrow CrowPanel Advance: STC8H1K28 at 0x30, 0 = brightest .. 245 = off) */
+#if defined(HASP_BACKLIGHT_I2C_ADDR)
+#include <LovyanGFX.hpp>
+#ifndef HASP_BACKLIGHT_I2C_PORT
+#define HASP_BACKLIGHT_I2C_PORT 0
+#endif
+#ifndef HASP_BACKLIGHT_I2C_SDA
+#define HASP_BACKLIGHT_I2C_SDA TOUCH_SDA
+#endif
+#ifndef HASP_BACKLIGHT_I2C_SCL
+#define HASP_BACKLIGHT_I2C_SCL TOUCH_SCL
+#endif
+#ifndef HASP_BACKLIGHT_I2C_FREQUENCY
+#define HASP_BACKLIGHT_I2C_FREQUENCY 100000
+#endif
+#ifndef HASP_BACKLIGHT_I2C_OFF_VALUE
+#define HASP_BACKLIGHT_I2C_OFF_VALUE 245 // value for backlight off, 0 = brightest
+#endif
+#ifndef HASP_BACKLIGHT_I2C_WAKE_CMD
+#define HASP_BACKLIGHT_I2C_WAKE_CMD 250 // "activate touch screen" command of the board MCU
+#endif
+#ifndef HASP_BACKLIGHT_I2C_WAKE_PIN
+#define HASP_BACKLIGHT_I2C_WAKE_PIN 1 // pulsed LOW when the board MCU / touch does not answer
+#endif
+#ifndef HASP_BUZZER_I2C_ON_CMD
+#define HASP_BUZZER_I2C_ON_CMD 246 // buzzer on / off commands of the board MCU (CrowPanel Advance V1.2: 246/247, V1.1: 0x15/0x16)
+#endif
+#ifndef HASP_BUZZER_I2C_OFF_CMD
+#define HASP_BUZZER_I2C_OFF_CMD 247
+#endif
+#ifndef HASP_BACKLIGHT_I2C_TOUCH_ADDR
+#define HASP_BACKLIGHT_I2C_TOUCH_ADDR I2C_TOUCH_ADDRESS
+#endif
+#endif
