+#if defined(HASP_BACKLIGHT_I2C_ADDR)
+static bool backlight_i2c_probe(uint8_t addr)
+{
+    return lgfx::i2c::transactionWrite(HASP_BACKLIGHT_I2C_PORT, addr, nullptr, 0, HASP_BACKLIGHT_I2C_FREQUENCY)
+        .has_value();
+}
+#endif
+
+void Esp32Device::init()
+{
+#if defined(HASP_BACKLIGHT_I2C_ADDR)
+    /* Same bus as the touch controller; LovyanGFX re-inits it later for the touch, that is harmless */
+    if(!lgfx::i2c::init(HASP_BACKLIGHT_I2C_PORT, HASP_BACKLIGHT_I2C_SDA, HASP_BACKLIGHT_I2C_SCL).has_value()) {
+        LOG_ERROR(TAG_GUI, F("Backlight  : I2C init failed (port %d, sda %d, scl %d)"), HASP_BACKLIGHT_I2C_PORT,
+                  HASP_BACKLIGHT_I2C_SDA, HASP_BACKLIGHT_I2C_SCL);
+        return;
+    }
+
+    /* Wake sequence as used by the vendor demo: retry until board MCU and touch controller answer */
+    for(uint8_t attempt = 0; attempt < 10; attempt++) {
+        if(backlight_i2c_probe(HASP_BACKLIGHT_I2C_ADDR) && backlight_i2c_probe(HASP_BACKLIGHT_I2C_TOUCH_ADDR)) {
+            LOG_VERBOSE(TAG_GUI, F("Backlight  : I2C controller 0x%02x and touch 0x%02x detected"),
+                        HASP_BACKLIGHT_I2C_ADDR, HASP_BACKLIGHT_I2C_TOUCH_ADDR);
+            break;
+        }
+        LOG_WARNING(TAG_GUI, F("Backlight  : I2C controller 0x%02x / touch 0x%02x not answering, waking (%d)"),
+                    HASP_BACKLIGHT_I2C_ADDR, HASP_BACKLIGHT_I2C_TOUCH_ADDR, attempt);
+        backlight_i2c_write(HASP_BACKLIGHT_I2C_WAKE_CMD);
+#if HASP_BACKLIGHT_I2C_WAKE_PIN >= 0
+        pinMode(HASP_BACKLIGHT_I2C_WAKE_PIN, OUTPUT);
+        digitalWrite(HASP_BACKLIGHT_I2C_WAKE_PIN, LOW);
+        delay(120);
+        pinMode(HASP_BACKLIGHT_I2C_WAKE_PIN, INPUT);
+#endif
+        delay(100);
+    }
+
+    _backlight_i2c_ready = true;
+    update_backlight(); // apply initial power/level
+#endif
+}
+
+#if defined(HASP_BACKLIGHT_I2C_ADDR)
+void Esp32Device::backlight_i2c_write(uint8_t value)
+{
+    auto res = lgfx::i2c::transactionWrite(HASP_BACKLIGHT_I2C_PORT, HASP_BACKLIGHT_I2C_ADDR, &value, 1,
+                                           HASP_BACKLIGHT_I2C_FREQUENCY);
+    if(res.has_value()) {
+        LOG_VERBOSE(TAG_GUI, F("Backlight  : I2C 0x%02x <- %d"), HASP_BACKLIGHT_I2C_ADDR, value);
+    } else {
+        LOG_WARNING(TAG_GUI, F("Backlight  : I2C write to 0x%02x failed"), HASP_BACKLIGHT_I2C_ADDR);
+    }
+}
+#else
+void Esp32Device::backlight_i2c_write(uint8_t value)
+{}
+#endif
+
+void Esp32Device::set_buzzer(bool on)
+{
+#if defined(HASP_BACKLIGHT_I2C_ADDR)
+    LOG_INFO(TAG_GUI, F("Buzzer     : %s"), on ? "on" : "off");
+    if(_backlight_i2c_ready) backlight_i2c_write(on ? HASP_BUZZER_I2C_ON_CMD : HASP_BUZZER_I2C_OFF_CMD);
+#endif
+}
