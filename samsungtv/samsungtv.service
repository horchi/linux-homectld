[Unit]

Description = Samsung Tizen TV
After = network-online.target mosquitto.service
Wants = network-online.target
StartLimitInterval = 200
StartLimitBurst = 5

[Service]
EnvironmentFile=-/etc/default/samsungtv2mqtt
Type = simple
ExecStart = <BINDEST>/samsungtv.py ${SAMSUNGTV_MQTT} ${SAMSUNGTV_TOPIC} ${SAMSUNGTV_HOST} ${SAMSUNGTV_MAC} ${SAMSUNGTV_LOG_LEVEL} ${SAMSUNGTV_OPTS}
Restart = always
RestartSec = 30

[Install]

WantedBy = multi-user.target
